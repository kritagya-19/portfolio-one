// ============================================================================
// MAIN PORTFOLIO HERO COMPONENT
// ============================================================================
export default function App() {
  // Theme state: 'dark' matches the #161514 reference image; 'light' is warm alabaster
  const [theme, setTheme] = useState('dark');
  const isDark = theme === 'dark';

  // Hanging Rope Pull Physics State
  const [isPulling, setIsPulling] = useState(false);
  const [ropeHovered, setRopeHovered] = useState(false);

  // Rotating Calendar Roles State
  const roles = [
    { title: 'UI/UX Designer' },
    { title: 'Video Editor' },
    { title: 'Graphic Designer' },
    { title: 'Product Designer' },
    { title: 'Creative Dev' },
  ];
  const [roleIndex, setRoleIndex] = useState(0);
  const [isFlipping, setIsFlipping] = useState(false);
  const [isCalendarPaused, setIsCalendarPaused] = useState(false);

  // Character Hover, Localized Cursor Spotlight & Custom PNG Upload State
  const [isCharHovered, setIsCharHovered] = useState(false);
  const [cursorPos, setCursorPos] = useState({ x: 220, y: 240 });
  const [smoothCursor, setSmoothCursor] = useState({ x: 220, y: 240 });
  const [customCharImg, setCustomCharImg] = useState(null);
  const charContainerRef = useRef(null);
  const fileInputRef = useRef(null);

  // Smooth spring interpolation for the cursor reveal lens
  useEffect(() => {
    let animationFrameId;
    const updateSmoothCursor = () => {
      setSmoothCursor((prev) => ({
        x: prev.x + (cursorPos.x - prev.x) * 0.22,
        y: prev.y + (cursorPos.y - prev.y) * 0.22,
      }));
      animationFrameId = requestAnimationFrame(updateSmoothCursor);
    };
    animationFrameId = requestAnimationFrame(updateSmoothCursor);
    return () => cancelAnimationFrame(animationFrameId);
  }, [cursorPos]);

  const handleCharacterMouseMove = (e) => {
    if (!charContainerRef.current) return;
    const rect = charContainerRef.current.getBoundingClientRect();
    setCursorPos({
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
    });
  };

  const handleCharacterTouchMove = (e) => {
    if (!charContainerRef.current || !e.touches[0]) return;
    const rect = charContainerRef.current.getBoundingClientRect();
    setCursorPos({
      x: e.touches[0].clientX - rect.left,
      y: e.touches[0].clientY - rect.top,
    });
  };

  // Active Navigation & Modals
  const [activeNav, setActiveNav] = useState('Home');
  const [contactModalOpen, setContactModalOpen] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [navHoveredItem, setNavHoveredItem] = useState(null);

  // Automatic Calendar Role Flip Timer (every 2.8 seconds)
  useEffect(() => {
    if (isCalendarPaused) return;
    const timer = setInterval(() => {
      triggerNextRole();
    }, 2800);
    return () => clearInterval(timer);
  }, [roleIndex, isCalendarPaused]);

  const triggerNextRole = () => {
    setIsFlipping(true);
    setTimeout(() => {
      setRoleIndex((prev) => (prev + 1) % roles.length);
      setIsFlipping(false);
    }, 280);
  };

  // Handle Rope Click -> Pull physics + Theme Toggle
  const handleRopePull = () => {
    if (isPulling) return;
    setIsPulling(true);
    playSwitchSound(isDark);

    // Toggle theme right at the bottom of the pull stroke
    setTimeout(() => {
      setTheme((prev) => (prev === 'dark' ? 'light' : 'dark'));
    }, 160);

    // Release cord back up with spring bounce
    setTimeout(() => {
      setIsPulling(false);
    }, 450);
  };

  // Handle user uploading their own transparent PNG character image
  const handleImageUpload = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const url = URL.createObjectURL(file);
      setCustomCharImg(url);
    }
  };

  const navItems = [
    'Home',
    'Web Development',
    'App Development',
    'UI/UX Design',
    'Graphic Design',
    'My story',
    'Contact',
  ];

  const currentRole = roles[roleIndex];

  return (
    <div
      className={`relative min-h-screen w-full overflow-hidden select-none transition-colors duration-700 ease-out font-sans flex flex-col justify-between ${
        isDark
          ? 'bg-[#171615] text-[#F3F1ED]'
          : 'bg-[#F5F2EB] text-[#181715]'
